// Shared AI relay (relay/, a stateless Cloudflare Worker). Committed on purpose so a fresh clone gets working AI
// with no keys of its own. Claude, images and the Realtime voice all go through it.
//
// RELAY_TOKEN is NOT a secret: it ships inside every build, so anyone can read it. It only keeps casual scanners
// off the relay. The real protection is the relay's per-IP rate limits and the spend caps on the OpenAI and
// Anthropic accounts (see relay/README.md).
//
// RELAY_HOST has no https:// (xcconfig treats // as a comment); the app adds it. Until the relay is deployed this
// is a the deployed relay (2026-11-15).
RELAY_HOST = pretendthat-relay.pretendthat.workers.dev
RELAY_TOKEN = BT9jhDKOezuNUTP4695NTKfV02yHOht1

// Round 38: anonymous server-side show counts (relay POST /v1/shows/start + the X-PT-Show ticket on guide and kit
// calls). NO until the relay is deployed with the SHOWS KV namespace (relay/README.md, "Show counts"). Even with YES,
// a relay that doesn't know the endpoint, or can't be reached, is treated as "allow".
RELAY_SHOW_LIMITS = NO

// This file holds ONLY the relay. Debug.xcconfig adds the optional personal keys (git-ignored Secrets.xcconfig);
// Release.xcconfig never does, so personal keys can't ship in a release build.
