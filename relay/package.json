    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "typescript": "5.8.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
