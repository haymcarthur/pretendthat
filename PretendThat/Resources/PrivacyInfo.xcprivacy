<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PretendThat privacy manifest (round 37; decisions/2026-11-17-setup-rows-and-compliance.md).
  - No tracking, no tracking domains.
  - Collected data: Other User Content (the kid's words as TEXT, names removed, sent to OpenAI and Anthropic so Nutmeg
    can answer and write the game), not linked to the user, not used for tracking, App Functionality only. Declared
    because the providers may keep API data up to 30 days for abuse monitoring until Zero Data Retention is confirmed;
    once ZDR is in place at BOTH providers, this entry (and the App Store label) can become "Data Not Collected".
    Kids' audio never leaves the iPad (on-device speech, round 31). Purchases go through Apple (not declared).
  - Required-reason APIs: UserDefaults (CA92.1: the app's own settings and flags). System boot time (35F9.1): the mic
    and voice timing use CACurrentMediaTime / UITouch timestamps to measure time between events inside the app only.
    No file timestamp, disk space or active keyboard APIs are used (re-check before each release). Round D4's iCloud
    sync uses its own stamps inside the records, not file timestamps. Saved games in the user's own private iCloud
    (CloudKit private database) are not developer-collected data, so the collected-data list doesn't change.
  - Analytics (2026-11-17, decisions/2026-11-17-analytics-build.md): TelemetryDeck anonymous event counts, OFF until a
    grown-up turns on "Share anonymous usage counts". Product Interaction (fixed event names + fixed-word parameters:
    steps, scene numbers, player-count buckets, plan names; never anything about kids) and Device ID (a RANDOM per-install
    id made by the app, hashed by TelemetryDeck; not identifierForVendor, removed when sharing is turned off). Both not
    linked to the user, not used for tracking, Analytics purpose only. Matches the TelemetryDeck SDK's own manifest.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
