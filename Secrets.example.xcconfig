// Optional dev mode. Copy to Secrets.xcconfig (git-ignored) and paste your own keys. Never commit real keys.
// Without this file the app uses the shared relay from Relay.xcconfig (no keys needed).
// Personal keys win over the relay: set either one to call that provider directly with your key.
ANTHROPIC_API_KEY =
OPENAI_API_KEY =
// To point at your own relay instead, uncomment and fill these (they override Relay.xcconfig). Leave them
// commented out otherwise: a blank line here would switch the shared relay off.
// RELAY_HOST = your-relay.your-subdomain.workers.dev
// RELAY_TOKEN =
