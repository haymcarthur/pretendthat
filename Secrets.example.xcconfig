// Copy to Secrets.xcconfig (git-ignored) and paste your keys. Never commit real keys.
// The app runs without keys using the bundled airplane fallback.
ANTHROPIC_API_KEY =
OPENAI_API_KEY =
// Optional stateless relay. Write the URL without "//" problems: xcconfig treats // as a comment,
// so use RELAY_HOST (e.g. pretendthat-relay.example.workers.dev); the app adds https://.
RELAY_HOST =
RELAY_TOKEN =
